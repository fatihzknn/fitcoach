# ----------------------------------------------------------------------------
# Copy to .env and adjust. .env is git-ignored and must never contain real
# production secrets committed to source control.
# ----------------------------------------------------------------------------

# --- PostgreSQL (consumed by docker-compose.yml) ---
POSTGRES_USER=fitcoach
POSTGRES_PASSWORD=fitcoach
POSTGRES_DB=fitcoach
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# These override application.yml defaults. The defaults already match the values
# above for a zero-config local run; set them explicitly in any shared environment.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fitcoach
SPRING_DATASOURCE_USERNAME=fitcoach
SPRING_DATASOURCE_PASSWORD=fitcoach
SERVER_PORT=8080
APP_JWT_SECRET=local-dev-only-change-me-please-32chars-min
APP_JWT_EXPIRATION_MINUTES=1440
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- AI provider (placeholder; used from Phase 6) ---
# Leave blank to use the MockCoachAiProvider.
COACH_AI_PROVIDER=mock
OPENAI_API_KEY=

# --- Frontend (Next.js) ---
# Note: the frontend reads its own frontend/.env.local for NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
